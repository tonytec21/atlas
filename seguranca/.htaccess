# Arquivos de configuracao e o hash da senha do suporte nao sao servidos pela web.
<FilesMatch "^(config(\.local)?\.php|suporte_acesso\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
